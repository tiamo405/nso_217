+            return false;
+        }
+        if (!saveProgress()) {
+            System.out.println("AUTO NVHN: không ghi được tiến độ, tiếp tục trong tiến trình hiện tại.");
+            return false;
+        }
+        System.out.println("AUTO NVHN: chuyển sang tiến trình mới cho tài khoản "
