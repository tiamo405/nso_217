+                + ") nhân vật #" + (characterIndex + 1));
+        enabled = false;
+        try {
+            Session_ME.gI().gameAC();
+        } catch (Exception ignored) {
+        }
+        sleep(500L);
+        System.exit(HANDOFF_EXIT_CODE);
+        return true;
+    }
